{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "data-factory-nyc-dnyan"
		},
		"LS_DataLake_Payroll_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_DataLake_Payroll'"
		},
		"LS_SQL_NYCPayRoll_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQL_NYCPayRoll'"
		},
		"LS_Synapse_NYCPayRoll_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_Synapse_NYCPayRoll'"
		},
		"LS_DataLake_Payroll_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsnycpayrolldnyanpand.dfs.core.windows.net/"
		},
		"LS_SQL_NYCPayRoll_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "azure-sql-server-dnyan.database.windows.net"
		},
		"LS_SQL_NYCPayRoll_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "azure-sql-database-dnayn"
		},
		"LS_SQL_NYCPayRoll_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Dnyan"
		},
		"LS_Synapse_NYCPayRoll_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "azure-synapse-dnyan.sql.azuresynapse.net"
		},
		"LS_Synapse_NYCPayRoll_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "master"
		},
		"LS_Synapse_NYCPayRoll_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Dnyan"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "data-factory-nyc-dnyan_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_DataLake_Payroll_accountKey": {
						"value": "[parameters('LS_DataLake_Payroll_accountKey')]"
					},
					"LS_SQL_NYCPayRoll_password": {
						"value": "[parameters('LS_SQL_NYCPayRoll_password')]"
					},
					"LS_Synapse_NYCPayRoll_password": {
						"value": "[parameters('LS_Synapse_NYCPayRoll_password')]"
					},
					"LS_DataLake_Payroll_properties_typeProperties_url": {
						"value": "[parameters('LS_DataLake_Payroll_properties_typeProperties_url')]"
					},
					"LS_SQL_NYCPayRoll_properties_typeProperties_server": {
						"value": "[parameters('LS_SQL_NYCPayRoll_properties_typeProperties_server')]"
					},
					"LS_SQL_NYCPayRoll_properties_typeProperties_database": {
						"value": "[parameters('LS_SQL_NYCPayRoll_properties_typeProperties_database')]"
					},
					"LS_SQL_NYCPayRoll_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQL_NYCPayRoll_properties_typeProperties_userName')]"
					},
					"LS_Synapse_NYCPayRoll_properties_typeProperties_server": {
						"value": "[parameters('LS_Synapse_NYCPayRoll_properties_typeProperties_server')]"
					},
					"LS_Synapse_NYCPayRoll_properties_typeProperties_database": {
						"value": "[parameters('LS_Synapse_NYCPayRoll_properties_typeProperties_database')]"
					},
					"LS_Synapse_NYCPayRoll_properties_typeProperties_userName": {
						"value": "[parameters('LS_Synapse_NYCPayRoll_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "data-factory-nyc-dnyan_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'data-factory-nyc-dnyan_ArmTemplate_0')]"
			]
		}
	]
}